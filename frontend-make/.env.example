# Frontend build-time config (Vite). Copy to .env.local for local overrides.

# Backend API base. Local/Docker uses the proxy, so leave empty.
# For GitHub Pages set it to your Render backend, e.g.:
# VITE_API_BASE_URL=https://gamementor-api.onrender.com/api/v1
VITE_API_BASE_URL=

# Base path. "/" locally; "/<repo>/" for a GitHub Pages project site.
# The deploy workflow sets this automatically.
VITE_BASE=/
