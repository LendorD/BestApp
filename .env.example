APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://gamementor:gamementor@postgres:5432/gamementor?sslmode=disable
REDIS_URL=

OPENDOTA_BASE_URL=https://api.opendota.com
OPENDOTA_API_KEY=
# Optional Stratz API token (free): https://stratz.com/api -> enables extra AI Coach context
STRATZ_API_KEY=
STEAM_API_KEY=
OPENDOTA_TIMEOUT=10s

# AI Coach LLM. Recommended: OpenRouter (one key, many models incl. Claude/GPT).
#   AI_PROVIDER=openrouter
#   AI_API_KEY=sk-or-...                (https://openrouter.ai/keys)
#   AI_MODEL=anthropic/claude-3.5-sonnet  (or openai/gpt-4o-mini, etc.)
# OpenAI direct:  AI_PROVIDER=openai  AI_MODEL=gpt-4o-mini
# Local Ollama:   AI_PROVIDER=ollama  AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.1
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT=60s

CACHE_ENABLED=true
JOBS_ENABLED=true

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=10s

USE_MOCK_API=false
API_BASE_URL=http://localhost:8080/api/v1
DEFAULT_DOTA_ACCOUNT_ID=369102305
